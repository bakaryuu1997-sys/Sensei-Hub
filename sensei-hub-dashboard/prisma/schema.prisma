// This is your Prisma schema file
// Prepared for Sensei Hub

datasource db {
  provider = "sqlite"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

// Authentication is handled by Clerk; `id` is the Clerk userId.
// No password is stored locally.
model User {
  id            String    @id
  email         String?   @unique
  name          String?
  image         String?
  role          String    @default("USER")
  preferredLang String    @default("vi")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lessons       LessonProgress[]
  quizResults   QuizResult[]
  favorites     FavoriteVocab[]
  subscriptions PushSubscription[]
}

// Web Push 購読（1 ユーザー複数デバイス）。endpoint が一意。
model PushSubscription {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  endpoint       String    @unique
  p256dh         String
  auth           String
  lang           String    @default("vi") // 通知文面の言語（購読時の preferredLang）
  lastNotifiedAt DateTime?                 // 本日重複送信を防ぐ
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model LessonProgress {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  lessonId  String         // Path or Slug of the markdown file
  status    String         @default("IN_PROGRESS")
  lastViewed DateTime      @default(now())

  @@unique([userId, lessonId])
}

model Vocabulary {
  id           String   @id @default(uuid())
  termJa       String
  termVi       String
  termEn       String?
  reading      String?
  definitionJa String?
  definitionVi String?
  exampleJa    String?
  exampleVi    String?
  category     String?
  createdAt    DateTime @default(now())

  favoritedBy  FavoriteVocab[]
}

model FavoriteVocab {
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  vocabId   String
  vocab     Vocabulary @relation(fields: [vocabId], references: [id])

  @@id([userId, vocabId])
}

model Question {
  id          String   @id @default(uuid())
  type        String   @default("MULTIPLE_CHOICE")
  contentJa   String
  contentVi   String
  explanation String?
  category    String?
  level       Int      @default(1)

  options     Option[]
  results     QuizAnswer[]
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  textJa     String
  textVi     String
  isCorrect  Boolean  @default(false)
}

model QuizResult {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  score       Int
  totalItems  Int
  duration    Int
  createdAt   DateTime @default(now())
  
  answers     QuizAnswer[]
}

model QuizAnswer {
  id           String     @id @default(uuid())
  quizResultId String
  quizResult   QuizResult @relation(fields: [quizResultId], references: [id])
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])
  chosenOptionId String
  isCorrect    Boolean
}
