# ---------------------------------------------------------------------------
# Sensei Hub ダッシュボード — 環境変数テンプレート
# `.env` にコピーして実際の値を記入する。実物の `.env` は絶対にコミットしない。
# ---------------------------------------------------------------------------

# SQLite データベースファイル（libSQL アダプター）。下はローカル開発の既定値。
# EC2/Docker では永続ボリューム上のパスを指定する。例:
# file:/app/data/production.db
DATABASE_URL="file:./dev.db"

# Clerk 認証キー — https://dashboard.clerk.com で取得する
# NEXT_PUBLIC_* はビルド時に埋め込まれる（変更後は再ビルドが必要）。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk のルーティング（アプリ内の /login・/register ページに合わせる）
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"

# 任意: レッスンコンテンツディレクトリの絶対パス。
# 既定は ../lessons（リポジトリ構成）。Docker では /lessons。
# LESSONS_DIR="/lessons"
