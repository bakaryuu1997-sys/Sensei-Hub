# ---------------------------------------------------------------------------
# Sensei Hub Dashboard — environment template
# Copy to `.env` and fill in real values. NEVER commit your real `.env`.
# ---------------------------------------------------------------------------

# SQLite database file (libSQL adapter). Local dev default below.
# On EC2/Docker this is set to a path on a persistent volume, e.g.
# file:/app/data/production.db
DATABASE_URL="file:./dev.db"

# Clerk authentication keys — get them from https://dashboard.clerk.com
# NEXT_PUBLIC_* values are inlined at BUILD time (rebuild after changing them).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk routing (match the in-app /login and /register pages)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"

# Optional: absolute path to the lessons content directory.
# Defaults to ../lessons (repo layout). In Docker this is /lessons.
# LESSONS_DIR="/lessons"
