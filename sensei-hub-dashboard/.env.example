# ---------------------------------------------------------------------------
# Sensei Hub ダッシュボード — 環境変数テンプレート
# `.env` にコピーして実際の値を記入する。実物の `.env` は絶対にコミットしない。
# ---------------------------------------------------------------------------

# SQLite データベースファイル（libSQL アダプター）。下はローカル開発の既定値。
# EC2/Docker では永続ボリューム上のパスを指定する。例:
# file:/app/data/production.db
DATABASE_URL="file:./dev.db"

# Clerk 認証キー — https://dashboard.clerk.com で取得する
# NEXT_PUBLIC_* はビルド時に埋め込まれる（変更後は再ビルドが必要）。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk のルーティング（アプリ内の /login・/register ページに合わせる）
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"

# 任意: レッスンコンテンツディレクトリの絶対パス。
# 既定は ../lessons（リポジトリ構成）。Docker では /lessons。
# LESSONS_DIR="/lessons"

# ---------------------------------------------------------------------------
# 任意: Web Push 学習リマインド（バックグラウンド通知）。
# 鍵が無ければ通知機能と日次 cron は自動で無効になる（アプリは正常動作）。
# 生成: `node -e "console.log(require('web-push').generateVAPIDKeys())"`
# 公開鍵は VAPID_PUBLIC_KEY と NEXT_PUBLIC_VAPID_PUBLIC_KEY に同じ値を入れる
# （後者はビルド時に埋め込まれるため変更後は再ビルドが必要）。
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY="B......（公開鍵）"
# VAPID_PRIVATE_KEY="......（秘密鍵・サーバー専用）"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="B......（VAPID_PUBLIC_KEY と同値）"
# VAPID_SUBJECT="mailto:admin@example.com"
# REMINDER_HOUR="20"   # 日次リマインドの送信時刻（サーバー TZ・0-23）

# ---------------------------------------------------------------------------
# 任意: ログイン込み E2E（Playwright + @clerk/testing）用。
# 下記が揃っている時だけ認証フローのテストが走る（無い時はスモークのみ実行）。
# Clerk の「テスト」インスタンスのキーと、そこに作ったテスト用ユーザーを使う。
# ---------------------------------------------------------------------------
# E2E_CLERK_USER_USERNAME="e2e-user@example.com"
# E2E_CLERK_USER_PASSWORD="********"
